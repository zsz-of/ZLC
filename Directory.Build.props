<Project>
  <PropertyGroup>
    <!-- .NET for Android 命令行构建使用的 Android SDK 路径（本机手动安装，无 Android Studio） -->
    <AndroidSdkDirectory Condition="'$(AndroidSdkDirectory)' == '' and '$(TargetFramework)' != ''">D:\Android\Sdk</AndroidSdkDirectory>
  </PropertyGroup>
  <!-- TargetFramework 在 props 导入时为空，改为 targets 之前兜底：直接在每个 android 项目求值后期生效 -->
  <PropertyGroup>
    <AndroidSdkDirectory Condition="'$(AndroidSdkDirectory)' == ''">D:\Android\Sdk</AndroidSdkDirectory>
  </PropertyGroup>
</Project>
