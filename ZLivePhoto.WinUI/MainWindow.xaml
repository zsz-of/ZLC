<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="ZLivePhoto.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ZLivePhoto.WinUI"
    Title="Z-LivePhoto-Converter">

    <Grid Padding="12" RowSpacing="8">
        <!-- ============================================================
             动态排版（仿 Windows 11 设置）：
             Narrow  < 700：格式单选竖排(2列)，输出目录两行，隐藏拖放提示
             Medium 700-899：格式单选横排(3列)，输出目录一行，隐藏拖放提示
             Wide   >= 900 ：格式单选横排(5列)，输出目录一行，显示拖放提示
             阈值为逻辑像素（AdaptiveTrigger 按 DPI 自动换算）
             ============================================================ -->
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="WideState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="900" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="FormatPanel.Orientation" Value="Horizontal" />
                        <Setter Target="FormatRadios.MaxColumns" Value="5" />
                        <Setter Target="OutDirLabel.(Grid.Row)" Value="0" />
                        <Setter Target="OutDirBox.(Grid.Row)" Value="0" />
                        <Setter Target="OutDirBox.(Grid.Column)" Value="1" />
                        <Setter Target="OutDirBox.(Grid.ColumnSpan)" Value="1" />
                        <Setter Target="BrowseBtn.(Grid.Row)" Value="0" />
                        <Setter Target="BrowseBtn.(Grid.Column)" Value="2" />
                        <Setter Target="DragHint.Visibility" Value="Visible" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="MediumState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="700" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="FormatPanel.Orientation" Value="Horizontal" />
                        <Setter Target="FormatRadios.MaxColumns" Value="3" />
                        <Setter Target="OutDirLabel.(Grid.Row)" Value="0" />
                        <Setter Target="OutDirBox.(Grid.Row)" Value="0" />
                        <Setter Target="OutDirBox.(Grid.Column)" Value="1" />
                        <Setter Target="OutDirBox.(Grid.ColumnSpan)" Value="1" />
                        <Setter Target="BrowseBtn.(Grid.Row)" Value="0" />
                        <Setter Target="BrowseBtn.(Grid.Column)" Value="2" />
                        <Setter Target="DragHint.Visibility" Value="Collapsed" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="NarrowState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="FormatPanel.Orientation" Value="Vertical" />
                        <Setter Target="FormatRadios.MaxColumns" Value="2" />
                        <Setter Target="OutDirLabel.(Grid.Row)" Value="0" />
                        <Setter Target="OutDirBox.(Grid.Row)" Value="1" />
                        <Setter Target="OutDirBox.(Grid.Column)" Value="0" />
                        <Setter Target="OutDirBox.(Grid.ColumnSpan)" Value="2" />
                        <Setter Target="BrowseBtn.(Grid.Row)" Value="1" />
                        <Setter Target="BrowseBtn.(Grid.Column)" Value="2" />
                        <Setter Target="DragHint.Visibility" Value="Collapsed" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 文件列表（支持拖放），卡片背景保证在 Mica 背景上可辨识 -->
        <ListView
            x:Name="FileList"
            Grid.Row="0"
            AllowDrop="True"
            DragEnter="FileList_DragEnter"
            Drop="FileList_Drop"
            SelectionMode="Extended"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="4"
            MinHeight="120">
            <ListView.HeaderTemplate>
                <DataTemplate>
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="1.2*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="文件" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="1" Text="格式" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="2" Text="状态" FontWeight="SemiBold" />
                    </Grid>
                </DataTemplate>
            </ListView.HeaderTemplate>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="local:FileItem">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="1.2*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{x:Bind DisplayName}" TextTrimming="CharacterEllipsis"
                                   Foreground="{x:Bind ForegroundBrush, Mode=OneWay}"
                                   TextDecorations="{x:Bind TextDecorations, Mode=OneWay}"
                                   ToolTipService.ToolTip="{x:Bind Path}" />
                        <TextBlock Grid.Column="1" Text="{x:Bind FormatName}"
                                   Foreground="{x:Bind ForegroundBrush, Mode=OneWay}"
                                   TextDecorations="{x:Bind TextDecorations, Mode=OneWay}" />
                        <TextBlock Grid.Column="2" Text="{x:Bind Status}"
                                   Foreground="{x:Bind ForegroundBrush, Mode=OneWay}"
                                   TextDecorations="{x:Bind TextDecorations, Mode=OneWay}" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- 扫描进度（默认隐藏） -->
        <Grid x:Name="ScanProgressPanel" Grid.Row="1" ColumnSpacing="8" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center" Text="正在扫描动态照片..." />
            <ProgressBar Grid.Column="1" IsIndeterminate="True" VerticalAlignment="Center" />
        </Grid>

        <!-- 列表操作按钮 -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8">
            <Button Content="添加文件" Click="AddFiles_Click" />
            <Button Content="添加文件夹" Click="AddFolder_Click" />
            <Button Content="移除选中" Click="RemoveSelected_Click" />
            <Button Content="清空列表" Click="ClearList_Click" />
            <TextBlock x:Name="DragHint" VerticalAlignment="Center"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Text="（可将文件/文件夹拖入列表）" />
        </StackPanel>

        <!-- 输出格式（单选，Google/Apple 靠前）；窄屏竖排、宽屏横排由 VisualState 切换 -->
        <StackPanel x:Name="FormatPanel" Grid.Row="3" Orientation="Horizontal" Spacing="12" Margin="0,4,0,0">
            <TextBlock VerticalAlignment="Center" Text="输出格式：" FontWeight="SemiBold" />
            <RadioButtons x:Name="FormatRadios" MaxColumns="5" SelectionChanged="FormatRadios_SelectionChanged" />
            <!-- vivo 单文件警告条（选中 vivo 单文件时显示，黑字红底） -->
            <Border x:Name="VivoSingleWarning" Visibility="Collapsed" VerticalAlignment="Center"
                    Background="#8B0000" CornerRadius="4" Padding="10,5">
                <TextBlock Text="⚠ 过老的机型可能无法识别此格式"
                           FontWeight="Bold" Foreground="Black" FontSize="12" />
            </Border>
        </StackPanel>

        <!-- 输出目录；窄屏标签独占一行、输入框+按钮第二行，宽屏单行，由 VisualState 切换 -->
        <Grid Grid.Row="4" ColumnSpacing="8" RowSpacing="4" Margin="0,4,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="OutDirLabel" Grid.Row="0" Grid.Column="0"
                       VerticalAlignment="Center" Text="输出目录：" FontWeight="SemiBold" />
            <TextBox x:Name="OutDirBox" Grid.Row="0" Grid.Column="1" VerticalAlignment="Center"
                     PlaceholderText="留空则输出到源文件所在目录" />
            <Button x:Name="BrowseBtn" Grid.Row="0" Grid.Column="2"
                    Content="浏览…" Click="BrowseOutDir_Click" />
        </Grid>

        <!-- 转换按钮 + 进度 -->
        <Grid Grid.Row="5" ColumnSpacing="8" Margin="0,4,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button x:Name="ConvertBtn" Content="开始转换" Click="Convert_Click"
                    Style="{ThemeResource AccentButtonStyle}" />
            <ProgressBar x:Name="Progress" Grid.Column="1" VerticalAlignment="Center"
                         Minimum="0" Maximum="100" Value="0" />
        </Grid>

        <!-- 底栏 -->
        <Grid Grid.Row="6" Margin="0,4,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusText" Grid.Column="1" VerticalAlignment="Center"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="就绪" />
        </Grid>
    </Grid>
</Window>
