<?xml version="1.0" encoding="utf-8"?>
<!--
  应用语言清单（Android 13+「每应用语言」/ 系统「应用语言」入口读取）。

  ⚠️ 只保留 8 种语言（用户 2026-10-11 决策：降低开发成本 —— 新增功能只需补这几种语言的翻译）：
    简体中文（基准 res/values/）、繁体中文、English、한국어、日本語、العربية、Español、文言（lzh）

  资源目录命名规则（BCP-47 带 b+ 前缀）：
    zh-Hans -> 直接用基准 res/values/（简体中文就是兜底语言，无需单独目录）
    zh-Hant -> values-b+zh+Hant    lzh(文言) -> values-b+lzh
    en      -> values-b+en         ja        -> values-b+ja
    ko      -> values-b+ko         ar        -> values-b+ar     es -> values-b+es

  设备语言不在本清单内时回落基准简体中文。
-->
<locale-config xmlns:android="http://schemas.android.com/apk/res/android">
    <locale android:name="ar" />
    <locale android:name="en" />
    <locale android:name="es" />
    <locale android:name="ja" />
    <locale android:name="ko" />
    <locale android:name="lzh" />
    <locale android:name="zh-Hans" />
    <locale android:name="zh-Hant" />
</locale-config>
