<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="29" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <uses-permission android:name="android.permission.READ_MEDIA_VISUAL_USER_SELECTED" />
    <!-- Photo Picker 的 content 流默认脱敏 GPS EXIF；声明此权限后可读取完整位置元数据 -->
    <uses-permission android:name="android.permission.ACCESS_MEDIA_LOCATION" />
    <!-- Android 11+「所有文件访问」：个别 OEM（如魅族）经 MediaStore 写入会脱敏 EXIF GPS，
         授权后本程序改为直写公共相册目录，完整保留位置元数据 -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <!-- 设置页/启动时检查更新、应用内一键下载安装：访问 GitHub API / 蓝奏云 / 下载文件 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 应用内一键更新：下载完成后调起系统安装器（Android 8+ 需用户在本应用授权「安装未知应用」） -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- 引导卸载旧版本（Go 版）：Android 9+ 发起卸载请求需声明此普通权限（无需运行时申请） -->
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />

    <!-- 支付宝赞助：声明对支付宝包可见，Android 11+ 才能 resolveActivity 检测是否已安装。
         这只是清单可见性声明（非权限，不弹授权窗） -->
    <!-- Android 11+ 包可见性：声明「查看 APK 安装包」意图后，本应用才能解析到系统安装器
         并对其授予 FileProvider URI 读权限，否则调起安装器可能失败/安装器读不到文件 -->
    <queries>
        <package android:name="com.eg.android.AlipayGphone" />
        <!-- 旧版本（Go 版）包名：Android 11+ 包可见性过滤下，声明后才能用 getPackageInfo 判断是否已安装 -->
        <package android:name="com.zsz.zlivephoto.go" />
        <!-- 正常版（完整版）包名：Go 版据此判断本机是否已装正常版，有则直接引导打开 -->
        <package android:name="com.zsz.zlivephoto" />
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="application/vnd.android.package-archive" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:name=".ZlcApplication"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:localeConfig="@xml/locales_config"
        android:hardwareAccelerated="true"
        android:largeHeap="true"
        android:enableOnBackInvokedCallback="true"
        android:theme="@style/Theme.ZLivePhoto">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
        </activity>

        <!-- 桌面入口只保留一个 activity-alias（MainActivityAlias0），图标固定为默认配色。
             曾用 7 个 alias 随主题色切换桌面图标，但有用户反馈会出现两个桌面图标，
             故整个「桌面图标自动改色」功能与其 6 个备用 alias 一并移除。
             保留 alias0 而不是把 LAUNCHER 挪回 MainActivity：已安装用户桌面上固定的
             入口组件名就是它，改名会让旧快捷方式变成打不开的死图标。 -->
        <activity-alias
            android:name=".MainActivityAlias0"
            android:targetActivity=".MainActivity"
            android:exported="true"
            android:enabled="true"
            android:icon="@mipmap/ic_launcher_0"
            android:roundIcon="@mipmap/ic_launcher_0_round"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- 应用内一键更新安装：下载到 cache/zlc_update 的 APK 通过 FileProvider 授权给系统安装器 -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
